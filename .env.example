# ===== Database =====
DATABASE_URL=postgres://smartcampus:GANTI_PASSWORD@127.0.0.1:5432/smartcampus
DB_POOL_MAX=10

# ===== Auth (Better Auth) =====
# openssl rand -base64 32
BETTER_AUTH_SECRET=GANTI_DENGAN_RAHASIA_ACAK
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → OAuth client (Web). Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DOMAIN_SEKOLAH=semesta.sch.id

# ===== Email (magic link ortu & notifikasi). Kosong = cetak ke console (dev) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_DARI="Semesta Smart Campus <no-reply@semesta.sch.id>"

# ===== Payment gateway =====
# simulasi (dev) | mayar (produksi, setelah KYC & TODO di src/server/gateway/mayar.ts diisi)
GATEWAY=simulasi
SIMULASI_SECRET=ganti-di-dev
TOPUP_KEDALUWARSA_MENIT=60
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
# MAYAR_API_BASE=

# ===== Job terjadwal (cron memanggil /api/jobs/* dengan Bearer token ini) =====
CRON_SECRET=GANTI_DENGAN_RAHASIA_ACAK

# ===== Foto siswa untuk verifikasi kasir (F-42): folder berisi <NIS>.jpg =====
FOTO_SISWA_DIR=
