{
  "name": "semesta-smart-campus-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "bash db/migrate.sh",
    "db:reset": "bash db/migrate.sh --reset",
    "db:uji": "bash db/migrate.sh --uji",
    "auth:migrate": "npx @better-auth/cli migrate",
    "typecheck": "tsc --noEmit",
    "uji:api": "tsx --tsconfig tests/tsconfig.asli.json tests/uji_api.ts",
    "uji:api:shim": "tsx --tsconfig tests/tsconfig.json tests/uji_api.ts"
  },
  "dependencies": {
    "better-auth": "^1.3.0",
    "next": "^16.2.9",
    "nodemailer": "^6.9.0",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
